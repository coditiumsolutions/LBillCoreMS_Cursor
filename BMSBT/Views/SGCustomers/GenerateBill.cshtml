@model X.PagedList.IPagedList<BMSBT.Models.CustomersDetail>
@using System.Text.Json
@using X.PagedList
@using X.PagedList.Mvc.Core
@{
    Layout = "~/Views/Shared/_LayoutEBills.cshtml";
    var selectedProject = ViewBag.SelectedProject as string;
    var selectedBlock = ViewBag.SelectedBlock as string;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "Not Generated";
    var btNoSearch = ViewBag.BTNoSearch as string;
    var projects = ViewBag.Projects as List<string> ?? new List<string>();
    var blocks = ViewBag.Blocks as List<string> ?? new List<string>();
    var statuses = ViewBag.Statuses as List<string> ?? new List<string> { "Not Generated", "Generated" };
    var billingMonth = ViewBag.BillingMonth as string;
    var billingYear = ViewBag.BillingYear as string;
}

@{
    string operatorJson = Context.Session.GetString("OperatorSetupDetail");
    string operatorName = "", sessionBillingMonth = "", sessionBillingYear = "";

    if (!string.IsNullOrEmpty(operatorJson))
    {
        var setup = JsonSerializer.Deserialize<Dictionary<string, string>>(operatorJson);
        operatorName = setup != null && setup.ContainsKey("OperatorName") ? setup["OperatorName"] : "";
        sessionBillingMonth = setup != null && setup.ContainsKey("BillingMonth") ? setup["BillingMonth"] : "";
        sessionBillingYear = setup != null && setup.ContainsKey("BillingYear") ? setup["BillingYear"] : "";
    }

    if (string.IsNullOrWhiteSpace(billingMonth))
    {
        billingMonth = sessionBillingMonth;
    }
    if (string.IsNullOrWhiteSpace(billingYear))
    {
        billingYear = sessionBillingYear;
    }
    if (string.IsNullOrWhiteSpace(operatorName))
    {
        operatorName = ViewBag.OperatorName as string ?? "";
    }
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    #loadingOverlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.7);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
    }
    #loadingOverlay .spinner-border {
        width: 3rem;
        height: 3rem;
    }

    .btn-theme {
        background-color: #00203F;
        border-color: #00203F;
        color: #fff;
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
        line-height: 1.3;
        height: auto;
        min-height: 0;
    }

    .btn-theme:hover,
    .btn-theme:focus {
        background-color: #00335f;
        border-color: #00335f;
        color: #fff;
    }
</style>

<div id="loadingOverlay">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="mb-3">
    <span class="fw-bold text-primary">Operator:</span> @operatorName |
    <span class="fw-bold text-primary">Billing Month:</span> @billingMonth |
    <span class="fw-bold text-primary">Billing Year:</span> @billingYear
</div>

<form method="get" asp-action="GenerateBill" asp-controller="SGCustomers" id="generateBillFilterForm">
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold" for="selectedProject">Project</label>
            <select name="selectedProject" id="selectedProject" class="form-select">
                <option value="">-- Select Project --</option>
                @foreach (var project in projects)
                {
                    if (project == selectedProject)
                    {
                        <option value="@project" selected>@project</option>
                    }
                    else
                    {
                        <option value="@project">@project</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold" for="selectedBlock">Block</label>
            <select name="selectedBlock" id="selectedBlock" class="form-select">
                <option value="">-- All Blocks --</option>
                @foreach (var blk in blocks)
                {
                    if (string.Equals(blk, selectedBlock, StringComparison.Ordinal))
                    {
                        <option value="@blk" selected>@blk</option>
                    }
                    else
                    {
                        <option value="@blk">@blk</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold" for="selectedStatus">Status</label>
            <select name="selectedStatus" id="selectedStatus" class="form-select">
                @foreach (var status in statuses)
                {
                    if (string.Equals(status, selectedStatus, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold" for="btNoSearch">Search by BTNo</label>
            <input type="text" name="btNoSearch" id="btNoSearch" value="@btNoSearch" class="form-control" placeholder="Enter BTNo..." />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex">
                <button type="submit" class="btn btn-theme mr-2" style="min-width:120px">Search</button>
                <button id="createRecordelec" type="button" class="btn btn-theme" style="min-width:120px">Generate Bill</button>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(selectedProject) && (string.IsNullOrWhiteSpace(billingMonth) || string.IsNullOrWhiteSpace(billingYear)))
{
    <div class="alert alert-warning">Operator billing month/year is not set. Update Operator Setup to filter by generation status.</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:40px">
                    <input type="checkbox" id="selectAllCustomers" title="Select all on this page" />
                </th>
                <th>BT Number</th>
                <th>Customer Name</th>
                <th>Sector</th>
                <th>Block</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var customer in Model)
                {
                    <tr ondblclick="window.location.href='@Url.Action("ViewCustomer", "SGCustomers", new { id = customer.Uid })'"
                        style="cursor: pointer;">
                        <td>
                            <input type="checkbox" name="selectedCustomers"
                                   value="@customer.Uid"
                                   class="customer-checkbox" />
                        </td>
                        <td>@customer.Btno</td>
                        <td>@customer.CustomerName</td>
                        <td>@customer.Sector</td>
                        <td>@customer.Block</td>
                        <td>@selectedStatus</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(selectedProject) ? "Select filters and click Search to load customers." : "No records found for the selected filters.")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.TotalItemCount > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <div class="text-muted small">
            Showing @Model.FirstItemOnPage–@Model.LastItemOnPage of @Model.TotalItemCount
        </div>
        <div>
            @Html.PagedListPager(Model, pageNumber => Url.Action("GenerateBill", new
            {
                selectedProject,
                selectedBlock,
                selectedStatus,
                btNoSearch,
                page = pageNumber
            }),
            new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                UlElementClasses = new[] { "pagination mb-0" },
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 5
            })
        </div>
    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"
        integrity="sha256-/xUj+3OJ+Y3TSLRmXX2mY+6pLDcXul5/6p1w5IBXtk=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        var blocksUrl = '@Url.Action("GetBlocksByProject", "SGCustomers")';
        var previouslySelectedBlock = '@(selectedBlock ?? "")';

        function loadBlocks(project, keepSelectedBlock) {
            var $block = $('#selectedBlock');
            $block.empty().append($('<option>', { value: '', text: '-- All Blocks --' }));

            if (!project) {
                return;
            }

            $.getJSON(blocksUrl, { project: project }, function (blocks) {
                (blocks || []).forEach(function (blk) {
                    var opt = $('<option>', { value: blk, text: blk });
                    if (keepSelectedBlock && blk === previouslySelectedBlock) {
                        opt.prop('selected', true);
                    }
                    $block.append(opt);
                });
            });
        }

        // Changing Project only refreshes Block list — does not run Search
        $('#selectedProject').on('change', function () {
            previouslySelectedBlock = '';
            loadBlocks($(this).val(), false);
        });

        $('#selectAllCustomers').on('change', function () {
            $('.customer-checkbox').prop('checked', this.checked);
        });

        $('#createRecordelec').click(function () {
            var selectedIds = $('input[name="selectedCustomers"]:checked')
                .map(function () {
                    var v = parseInt($(this).val());
                    return isNaN(v) ? null : v;
                })
                .get()
                .filter(id => id !== null);

            if (selectedIds.length === 0) {
                alert('No records selected.');
                return;
            }

            $('#loadingOverlay').css('display', 'flex');

            $.ajax({
                url: '@Url.Action("GenerateElectricityBills", "EBillU")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ selectedIds: selectedIds }),
                success: function (response) {
                    $('#loadingOverlay').hide();

                    var msg = response.message || response.Message || '';
                    var generated = response.generatedCount || 0;

                    if (response.success || response.Success) {
                        alert(msg || 'Bills Generated');
                        window.location.reload();
                    } else {
                        alert(msg || 'No bills were generated.');
                        if (generated > 0) {
                            window.location.reload();
                        }
                    }
                },
                error: function () {
                    $('#loadingOverlay').hide();
                    alert('An error occurred while creating electricity bills.');
                }
            });
        });
    });
</script>
