@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<BMSBT.Models.CustomersDetail>

<div id="eCustomerTotalMeta" class="d-none" data-total="@Model.TotalItemCount" aria-hidden="true"></div>

<div class="table-responsive cm-table-wrap mx-2 my-2 mb-0">
    <table class="cm-detail-table cm-customers-grid-table mb-0" id="customersTable">
        <thead>
            <tr>
                <th scope="col">BT No</th>
                <th scope="col">Customer Name</th>
                <th scope="col">Plot No</th>
                <th scope="col">Sector</th>
                <th scope="col">Block</th>
                <th scope="col">Project</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Uid">
                    <td>@item.Btno</td>
                    <td>@item.CustomerName</td>
                    <td>@item.PloNo</td>
                    <td>@item.Sector</td>
                    <td>@item.Block</td>
                    <td>@item.Project</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-controller="SSQCustomers" asp-action="Details" asp-route-id="@item.Uid"
                               class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-controller="SSQCustomers" asp-action="Edit" asp-route-id="@item.Uid"
                               class="btn btn-outline-warning" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="cm-grid-pager d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("FilterECustomers", new { page }),
        new PagedListRenderOptions {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            DisplayPageCountAndCurrentLocation = true,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>
