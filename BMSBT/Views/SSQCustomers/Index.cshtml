@{
    ViewData["Title"] = "Customers";
    Layout = "_LayoutSSQCustomers";
}

<style>
    .customer-hub .section-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .customer-hub .section-card:hover {
        box-shadow: 0 6px 10px rgba(0, 0, 0, 0.14);
    }

    .customer-hub .section-title {
        color: #142141;
        font-weight: 700;
    }

    .customer-hub .section-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-left: 0.35rem;
        vertical-align: middle;
    }

    .customer-hub .badge-e {
        background: #e8f1ff;
        color: #1e40af;
    }

    .customer-hub .badge-m {
        background: #ecfdf5;
        color: #047857;
    }
</style>

<div class="container-fluid customer-hub px-2">
    <div class="mb-3">
        <h4 class="mb-1" style="color:#142141;">Customers</h4>
        <p class="text-muted mb-0">Choose electricity or maintenance customer records.</p>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card section-card p-4">
                <h5 class="section-title">
                    E-Customers
                    <span class="section-badge badge-e">Electricity</span>
                </h5>
                <p class="mt-3 mb-4">Search electricity customers by project, sector, and BT / plot number. Create, edit, view, and delete records.</p>
                <a asp-controller="SSQCustomers" asp-action="ECustomers" class="btn btn-success">
                    <i class="fas fa-bolt mr-1"></i> E-Customers
                </a>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card section-card p-4">
                <h5 class="section-title">
                    M-Customers
                    <span class="section-badge badge-m">Maintenance</span>
                </h5>
                <p class="mt-3 mb-4">Search maintenance customers by project, sector, and BT / plot number. Create, edit, view, and delete records.</p>
                <a asp-controller="SSQCustomers" asp-action="MCustomers" class="btn btn-success">
                    <i class="fas fa-cogs mr-1"></i> M-Customers
                </a>
            </div>
        </div>
    </div>
</div>
