@{
    ViewData["Title"] = "Customers";
    Layout = "_LayoutSSQCustomers";
}

<style>
    .home-modules {
        margin-top: 1rem;
    }

    .module-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #d9e0ea;
        border-radius: 12px;
        background-color: #f7f9fc;
        background-image:
            linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(247, 249, 252, 0.9) 100%),
            url('@Url.Content("~/images/buildings.png")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow: 0 4px 14px rgba(20, 33, 65, 0.08);
        padding: 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
        overflow: hidden;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(20, 33, 65, 0.14);
        border-color: #b8c6db;
    }

    .module-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #fff;
        font-size: 1.35rem;
    }

    .module-icon.ecustomers { background: linear-gradient(135deg, #f0ad4e, #d48806); }
    .module-icon.mcustomers { background: linear-gradient(135deg, #28a745, #1e7e34); }

    .module-title {
        color: #142141;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .module-desc {
        color: #5b6777;
        font-size: 0.92rem;
        line-height: 1.45;
        flex-grow: 1;
        margin-bottom: 1rem;
    }

    .module-btn {
        background-color: #142141;
        border: none;
        color: #fff;
        border-radius: 8px;
        padding: 0.55rem 0.9rem;
        font-weight: 600;
        text-align: center;
        transition: background-color 0.2s ease;
    }

    .module-btn:hover {
        background-color: #0d1733;
        color: #fff;
        text-decoration: none;
    }

    .module-btn i {
        margin-left: 6px;
        font-size: 0.85rem;
    }
</style>

<div class="home-modules">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="module-card">
                <div class="module-icon ecustomers">
                    <i class="fas fa-bolt"></i>
                </div>
                <h5 class="module-title">E-Customers</h5>
                <p class="module-desc">Search electricity customers by project, sector, and BT / plot number. Create, edit, view, and delete records.</p>
                <a asp-controller="SSQCustomers" asp-action="ECustomers" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="module-card">
                <div class="module-icon mcustomers">
                    <i class="fas fa-cogs"></i>
                </div>
                <h5 class="module-title">M-Customers</h5>
                <p class="module-desc">Search maintenance customers by project, sector, and BT / plot number. Create, edit, view, and delete records.</p>
                <a asp-controller="SSQCustomers" asp-action="MCustomers" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
