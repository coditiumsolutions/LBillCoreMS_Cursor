@model BMSBT.Models.CustomersMaintenance

@{
    ViewData["Title"] = "Edit M-Customer";
    Layout = "_LayoutSSQCustomers";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="fas fa-edit"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="MEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Uid" />
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label asp-for="CustomerNo"></label>
                        <input asp-for="CustomerNo" class="form-control" />
                        <span asp-validation-for="CustomerNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="BTNo"></label>
                        <input asp-for="BTNo" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="CustomerName"></label>
                        <input asp-for="CustomerName" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="MobileNo"></label>
                        <input asp-for="MobileNo" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="Project"></label>
                        <input asp-for="Project" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="SubProject"></label>
                        <input asp-for="SubProject" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="Sector"></label>
                        <input asp-for="Sector" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="Block"></label>
                        <input asp-for="Block" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="PloNo"></label>
                        <input asp-for="PloNo" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="Category"></label>
                        <input asp-for="Category" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="TariffName"></label>
                        <input asp-for="TariffName" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="CNICNo"></label>
                        <input asp-for="CNICNo" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="City"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label asp-for="MeterNo"></label>
                        <input asp-for="MeterNo" class="form-control" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-warning">Save</button>
                    <a asp-action="MCustomers" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
