@model BMSBT.Models.CustomersDetail

@{
    ViewData["Title"] = "E-Customer Details";
    Layout = "_LayoutSSQCustomers";
}

@await Html.PartialAsync("_SSQCustomerDetailStyles")

<div class="container-fluid cm-detail-page px-2 px-md-2">
    <div class="card cm-detail-card shadow-sm border-0">
        <div class="card-header">
            <p class="cm-header-name">
                @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "—" : Model.CustomerName)
                @if (!string.IsNullOrWhiteSpace(Model.Btno))
                {
                    <span class="cm-badge-soft ml-2">BTNo @Model.Btno</span>
                }
                else if (Model.Uid > 0)
                {
                    <span class="cm-badge-soft ml-2">ID @Model.Uid</span>
                }
            </p>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive cm-table-wrap">
                <table class="cm-detail-table mb-0">
                    <tbody>
                        <tr>
                            <th scope="row">Customer No</th>
                            <td>@Model.CustomerNo</td>
                            <th scope="row">BT No</th>
                            <td>@Model.Btno</td>
                        </tr>
                        <tr>
                            <th scope="row">Customer Name</th>
                            <td>@Model.CustomerName</td>
                            <th scope="row">Father Name</th>
                            <td>@Model.FatherName</td>
                        </tr>
                        <tr>
                            <th scope="row">CNIC No</th>
                            <td>@Model.Cnicno</td>
                            <th scope="row">Mobile No</th>
                            <td>@Model.MobileNo</td>
                        </tr>
                        <tr>
                            <th scope="row">Telephone No</th>
                            <td>@Model.TelephoneNo</td>
                            <th scope="row">City</th>
                            <td>@Model.City</td>
                        </tr>
                        <tr>
                            <th scope="row">Project</th>
                            <td>@Model.Project</td>
                            <th scope="row">Sub Project</th>
                            <td>@Model.SubProject</td>
                        </tr>
                        <tr>
                            <th scope="row">Block</th>
                            <td>@Model.Block</td>
                            <th scope="row">Sector</th>
                            <td>@Model.Sector</td>
                        </tr>
                        <tr>
                            <th scope="row">Plot No</th>
                            <td>@Model.PloNo</td>
                            <th scope="row">Plot Type</th>
                            <td>@Model.PlotType</td>
                        </tr>
                        <tr>
                            <th scope="row">Category</th>
                            <td>@Model.Category</td>
                            <th scope="row">Size</th>
                            <td>@Model.Size</td>
                        </tr>
                        <tr>
                            <th scope="row">Tariff Name</th>
                            <td>@Model.TariffName</td>
                            <th scope="row">Meter No</th>
                            <td>@Model.MeterNo</td>
                        </tr>
                        <tr>
                            <th scope="row">Meter Type</th>
                            <td>@Model.MeterType</td>
                            <th scope="row">Installed On</th>
                            <td>@Model.InstalledOn</td>
                        </tr>
                        <tr>
                            <th scope="row">Bank No</th>
                            <td>@Model.BankNo</td>
                            <th scope="row">NTN Number</th>
                            <td>@Model.Ntnnumber</td>
                        </tr>
                        <tr>
                            <th scope="row">BT No Maintenance</th>
                            <td>@Model.BtnoMaintenance</td>
                            <th scope="row">Location Seq No</th>
                            <td>@Model.LocationSeqNo</td>
                        </tr>
                        <tr>
                            <th scope="row">Bill Status</th>
                            <td>@Model.BillStatus</td>
                            <th scope="row">Bill Status Maintenance</th>
                            <td>@Model.BillStatusMaint</td>
                        </tr>
                        <tr>
                            <th scope="row">Bill Generation Status</th>
                            <td>@Model.BillGenerationStatus</td>
                            <th scope="row">Generated Month/Year</th>
                            <td>@Model.GeneratedMonthYear</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="cm-card-footer-actions">
            <small class="text-muted mb-0 d-none d-sm-block pr-2">Electricity customer detail</small>
            <div class="btn-group-actions" role="group">
                <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-warning" title="Edit customer">
                    <i class="fas fa-edit"></i><span class="d-none d-sm-inline"> Edit</span>
                </a>
                <a asp-action="ECustomers" class="btn btn-outline-secondary" title="Back to list">
                    <i class="fas fa-arrow-left"></i><span class="d-none d-sm-inline"> Back to List</span>
                </a>
            </div>
        </div>
    </div>
</div>
