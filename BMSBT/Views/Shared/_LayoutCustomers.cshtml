<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Billing System</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>


    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" />
    @*   <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>

  
    <style>  
        .sidebar {
            position: absolute;
            min-height: 100vh;
            height: auto !important;
            background-color: #00203FFF;
        }

        .sidebar .collapse,
        .sidebar .collapse ul,
        .sidebar .collapse li {
            background-color: #00203FFF;
        }

        .sidebar h4 {
            color: #b8df10;
        }

        .sidebar .nav-link {
            color: white;
            background-color: transparent;
        }

        .sidebar .nav-link:hover {
            color: white;
            background-color: #3B559E;
        }

        .sidebar-section-title {
            color: #b8df10;
            font-size: 0.95rem;
            font-weight: 600;
            margin-top: 0.75rem;
            margin-bottom: 0.35rem;
        }

        .navbar2-top {
            background-color: #f8f9fa; /* Light background color */
            padding: 0px 0;
        }

        .navbar2-top .container { 
                display: flex;
                justify-content: space-between;
                align-items: center;
        }

        .navbar2-top .left-section {
                font-weight: bold;
        }

       .navbar2-top .right-section {
                text-align: right;
                flex-grow: 1;
       }

       .navbar2-top .left-section a {
                color: #0056b3;
       }
        a {
            text-decoration: none !important;
        }

        .user-info {
            color: #0056b3; /* Dark gray */
            font-size: 16px; /* Reduce font size */
            font-weight: normal;
        }

        

    </style>
    

</head>
<body>

    <!-- First Top Bar -->
    <nav class="navbar navbar-expand-lg navbar1-top navbar-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="~/images/logo.png" alt="Logo" class="logo-margin" style="height: 70px; margin-left: 10px;">
            </a>
            <span class="navbar-text text-white">Bahria Town: Billing System</span>
        </div>
    </nav>

    <!-- Second Top Bar -->
    <nav class="navbar navbar-expand-lg navbar2-top">
        <div class="container">
            <!-- Left-aligned text -->
            <div class="left-section">
                <a asp-controller="Home" asp-action="Index">Back Main Menu</a>
            </div>
            <!-- Right-aligned text -->
            <div class="right-section">
                <span class="user-info"> Logged-in as @ViewBag.Username at @ViewBag.LoginTime</span>
                <a asp-controller="Login" asp-action="Logout"
                   class="btn btn-link text-black"
                   onclick="return confirm('Are you sure you want to log out?');">
                    Logout
                </a>
            </div>
        </div>
    </nav>


    <!-- Third Top Bar -->
    <nav class="navbar navbar-expand-lg navbar3-top">
        <div class="container">
            <span class="navbar-text text-white"></span>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar">
                <h4>Customers</h4>


                <ul class="nav flex-column">

                    <li>
                        <a asp-controller="SSQCustomers" asp-action="Dashboard">
                            <i class="fas fa-chart-area" style="color: yellowgreen; font-size: 14px;"></i>
                            Dashboard
                        </a>
                    </li>

                    <li>
                        <a asp-controller="SSQCustomers" asp-action="Index">
                            <i class="fas fa-home" style="color: yellowgreen; font-size: 14px;"></i>
                            Home
                        </a>
                    </li>

                    <li class="nav-item mt-2">
                        <p class="sidebar-section-title mb-1 px-1">E-Customers</p>
                        <ul class="nav flex-column ml-2">
                            <li>
                                <a asp-controller="SSQCustomers" asp-action="ECustomers">
                                    <i class="fas fa-bolt" style="color: yellowgreen; font-size: 14px;"></i>
                                    E-Customers
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item mt-2">
                        <p class="sidebar-section-title mb-1 px-1">M-Customers</p>
                        <ul class="nav flex-column ml-2">
                            <li>
                                <a asp-controller="SSQCustomers" asp-action="MCustomers">
                                    <i class="fas fa-cogs" style="color: yellowgreen; font-size: 14px;"></i>
                                    M-Customers
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

               



                @* <!-- Separate Quick Links Block -->
                <div class="quick-links-block">
                    <h4>Quick Links</h4>
                    <ul class="nav flex-column">
                        <li>
                            <a asp-controller="EBillU" asp-action="Index">
                                <i class='fas fa-arrow-left' style="color: antiquewhite; font-size: 14px; font-weight: bold;"></i>
                                E-Bills
                            </a>
                        </li>
                        <li>
                            <a asp-controller="MaintenanceNew" asp-action="Index">
                                <i class='fas fa-arrow-left' style="color: antiquewhite; font-size: 14px; font-weight: bold;"></i>
                                M-Bills
                            </a>
                        </li>
                    </ul>
                </div> *@



            </div>


          


            <!-- Right Content Area -->
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    @*   <!-- Footer -->
    <footer class="footer text-white text-center py-3 footerarea">
        <p>&copy; 2024 My Application. All rights reserved.</p>
    </footer> *@


    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
