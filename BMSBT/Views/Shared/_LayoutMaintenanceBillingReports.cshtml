<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Maintenance reports</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>
    <style>
        .reports-shell .sidebar { position: absolute; }
    </style>
    @RenderSection("Head", required: false)
</head>
<body class="reports-shell">
    @await Html.PartialAsync("_TopBars", "Maintenance")

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 p-3 sidebar maint-report-nav">
                <h4>Reports</h4>
                <p class="small text-muted mb-3" style="opacity: 0.85;">Maintenance billing</p>
                <ul class="nav flex-column">
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Summary" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Summary">
                            <i class="fas fa-chart-pie" style="color: yellowgreen; font-size: 14px;"></i>
                            Summary
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Collections" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Collections">
                            <i class="fas fa-money-bill" style="color: yellowgreen; font-size: 14px;"></i>
                            Collections
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Recovery" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Recovery">
                            <i class="fas fa-sync" style="color: yellowgreen; font-size: 14px;"></i>
                            Recovery
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Customers" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Customers">
                            <i class="fas fa-users" style="color: yellowgreen; font-size: 14px;"></i>
                            Customers
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Billing" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Billing">
                            <i class="fas fa-file" style="color: yellowgreen; font-size: 14px;"></i>
                            Billing
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveReport as string == "Users" ? "active" : null)"
                           asp-controller="MaintenanceBillingReports" asp-action="Users">
                            <i class="fas fa-user" style="color: yellowgreen; font-size: 14px;"></i>
                            Users
                        </a>
                    </li>
                </ul>
                <div class="report-back-link">
                    <a asp-controller="MaintenanceNew" asp-action="Index">
                        <i class="fas fa-arrow-left" style="color: yellowgreen; font-size: 14px;"></i>
                        Back to Maintenance
                    </a>
                </div>
            </div>
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
