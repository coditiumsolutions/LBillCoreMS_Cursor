<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" />
    @*   <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>

    <title>@ViewData["Title"] - Billing System</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>

    <!-- jQuery -->
    @*   <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script> *@

    <!-- DataTables CSS -->
    @* <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" /> *@

    <!-- DataTables JS -->
    @* <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script> *@

    <style>
        .sidebar {
            position: absolute; /* Allow normal scrolling behavior */
        }
a {
            text-decoration: none !important;
        }
</style>
</head>
<body>

    @await Html.PartialAsync("_TopBars", "Reading Sheet")

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar">
                <h4>Reading Sheets</h4>

                <ul class="nav flex-column">
                    <li>
                        <a asp-controller="Reading" asp-action="Index">
                            <i class='fas fa-users' style="color: yellowgreen; font-size: 14px;"></i>
                            Dashboard
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reading" asp-action="AddReading">
                            <i class='fas fa-plus-circle' style="color: yellowgreen; font-size: 14px;"></i>
                            Add Reading
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reading" asp-action="SearchCustomer">
                            <i class='fas fa-money-bill' style="color: yellowgreen; font-size: 14px;"></i>
                            Search Customer
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reading" asp-action="Search">
                            <i class='fas fa-money-bill' style="color: yellowgreen; font-size: 14px;"></i>
                            Search
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reading" asp-action="ShowReading">
                            <i class='fas fa-money-bill' style="color: yellowgreen; font-size: 14px;"></i>
                            Reading Details
                        </a>
                    </li>

                   @*  <li>
                        <a asp-controller="ReadingSheet" asp-action="UploadReading">
                            <i class='fas fa-bolt' style="color: yellowgreen; font-size: 14px;"></i>
                            Upload Reading
                        </a>
                    </li> *@

                    <li>
                        <a asp-controller="Reading" asp-action="UploadExcel">
                            <i class='fas fa-bolt' style="color: yellowgreen; font-size: 14px;"></i>
                            Upload Reading
                        </a>
                    </li>
                

                    <li>
                        <a asp-controller="EBillU" asp-action="Index">
                 
                            <i class='fas fa-arrow-left' style="color: antiquewhite; font-size: 14px; font-weight: bold;"></i>
                            Click To: E-Bills
                        </a>
                    </li>

                </ul>
            </div>

            <!-- Right Content Area -->
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    @*   <!-- Footer -->
    <footer class="footer text-white text-center py-3 footerarea">
        <p>&copy; 2024 My Application. All rights reserved.</p>
    </footer> *@

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
