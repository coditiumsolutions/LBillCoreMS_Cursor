@* Views/Shared/HomePageLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>

    <title>@ViewData["Title"] - Billing System</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <style>
        .audit-shell .sidebar {
            position: absolute;
            min-height: 100vh;
            height: auto !important;
            background-color: #00203FFF;
        }
a {
            text-decoration: none !important;
        }
.audit-nav .collapse,
        .audit-nav .collapse ul,
        .audit-nav .collapse li {
            background-color: #00203FFF;
        }

        .audit-nav h4 {
            color: #b8df10;
        }

        .audit-nav ul.nav.flex-column > li > a {
            display: block;
            padding: 0.45rem 0.25rem;
            border-radius: 6px;
            color: inherit;
        }

        .audit-nav ul.nav.flex-column > li > a:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .audit-nav ul.nav.flex-column > li > a.active {
            background: rgba(37, 99, 235, 0.35);
            font-weight: 600;
        }

        .audit-nav ul.nav.flex-column ul.nav.flex-column > li > a {
            display: block;
            padding: 0.45rem 0.25rem;
            border-radius: 6px;
            color: inherit;
        }

        .audit-nav ul.nav.flex-column ul.nav.flex-column > li > a:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .audit-nav ul.nav.flex-column ul.nav.flex-column > li > a.active {
            background: rgba(37, 99, 235, 0.35);
            font-weight: 600;
        }

        .audit-nav .nav-link {
            color: inherit;
            background-color: transparent;
        }
    </style>

</head>
<body class="audit-shell">

    @await Html.PartialAsync("_TopBars", "Audit")

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar audit-nav">
                <h4>Audit</h4>

                <ul class="nav flex-column">
                    <li>
                        <a asp-controller="Audit" asp-action="Index">
                            <i class="fas fa-home" style="color: yellowgreen; font-size: 14px;"></i>
                            Home
                        </a>
                    </li>

                    <!-- Electricity -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#auditElectricitySubMenu"
                           role="button"
                           aria-expanded="false"
                           aria-controls="auditElectricitySubMenu">
                            <span>
                                <i class="fas fa-bolt" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Electricity
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="auditElectricitySubMenu">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="Audit" asp-action="AuditSummary">
                                        <i class='fas fa-clipboard-check' style="color: yellowgreen; font-size: 14px;"></i>
                                        Audit Summary
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <!-- Maintenance -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#auditMaintenanceSubMenu"
                           role="button"
                           aria-expanded="false"
                           aria-controls="auditMaintenanceSubMenu">
                            <span>
                                <i class="fas fa-cogs" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Maintenance
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="auditMaintenanceSubMenu">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="Audit" asp-action="MaintenanceAuditSummary">
                                        <i class='fas fa-clipboard-check' style="color: yellowgreen; font-size: 14px;"></i>
                                        Audit Summary
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Audit" asp-action="DataScience">
                                        <i class='fas fa-chart-line' style="color: yellowgreen; font-size: 14px;"></i>
                                        Data Science
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <!-- Others -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#auditOthersSubMenu"
                           role="button"
                           aria-expanded="false"
                           aria-controls="auditOthersSubMenu">
                            <span>
                                <i class="fas fa-ellipsis-h" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Others
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="auditOthersSubMenu">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="Audit" asp-action="OperatorsLog">
                                        <i class="fas fa-history" style="color: yellowgreen; font-size: 14px;"></i>
                                        Operators Log
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Audit" asp-action="AuditLogs">
                                        <i class="fas fa-clipboard-list" style="color: yellowgreen; font-size: 14px;"></i>
                                        Audit Logs
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Audit" asp-action="AI">
                                        <i class="fas fa-robot" style="color: yellowgreen; font-size: 14px;"></i>
                                        AI
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                </ul>

            </div>

            <!-- Right Content Area -->
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    @*   <!-- Footer -->
    <footer class="footer text-white text-center py-3 footerarea">
        <p>&copy; 2024 My Application. All rights reserved.</p>
    </footer> *@

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script>
        $(document).on('show.bs.collapse', '#auditElectricitySubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#auditElectricitySubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });

        $(document).on('show.bs.collapse', '#auditMaintenanceSubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#auditMaintenanceSubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });

        $(document).on('show.bs.collapse', '#auditOthersSubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#auditOthersSubMenu', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });
    </script>
</body>
</html>

