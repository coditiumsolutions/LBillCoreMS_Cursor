<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Dashboard reports</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>

    <style>
        .dashboard-shell .sidebar {
            position: absolute;
        }

        .navbar2-top {
            background-color: #f8f9fa;
            padding: 0;
        }

        .navbar2-top .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar2-top .left-section {
            font-weight: bold;
        }

        .navbar2-top .right-section {
            text-align: right;
            flex-grow: 1;
        }

        .navbar2-top .left-section a {
            color: #0056b3;
        }

        a {
            text-decoration: none !important;
        }

        .user-info {
            color: #0056b3;
            font-size: 16px;
            font-weight: normal;
        }

        /* Dashboard-only sidebar: report links */
        .dashboard-report-nav ul.nav.flex-column > li > a {
            display: block;
            padding: 0.45rem 0.25rem;
            border-radius: 6px;
            color: inherit;
        }

        .dashboard-report-nav ul.nav.flex-column > li > a:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .dashboard-report-nav ul.nav.flex-column > li > a.active {
            background: rgba(37, 99, 235, 0.35);
            font-weight: 600;
        }

        .dashboard-chart-card canvas {
            max-height: 420px;
        }

        .dashboard-back-link {
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            margin-top: 1rem;
            padding-top: 1rem;
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body class="dashboard-shell">

    <nav class="navbar navbar-expand-lg navbar1-top navbar-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="~/images/logo.png" alt="Logo" class="logo-margin" style="height: 70px; margin-left: 10px;">
            </a>
            <span class="navbar-text text-white">Bahria Town: Billing System</span>
        </div>
    </nav>

    <nav class="navbar navbar-expand-lg navbar2-top">
        <div class="container">
            <div class="left-section">
                <a asp-controller="Home" asp-action="Index">Back Main Menu</a>
            </div>
            <div class="right-section">
                <span class="user-info"> Logged-in as @ViewBag.UserName at @ViewBag.LoginTime</span>
                <a asp-controller="Login" asp-action="Logout"
                   class="btn btn-link text-black"
                   onclick="return confirm('Are you sure you want to log out?');">
                    Logout
                </a>
            </div>
        </div>
    </nav>

    <nav class="navbar navbar-expand-lg navbar3-top">
        <div class="container">
            <span class="navbar-text text-white"></span>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- Separate layout: only dashboard report destinations -->
            <div class="col-md-3 col-lg-2 p-3 sidebar dashboard-report-nav">
                <h4>Dashboard reports</h4>
                <p class="small text-muted mb-3" style="opacity: 0.85;">Maintenance analytics</p>

                <ul class="nav flex-column">
                    <li>
                        <a class="@(ViewBag.ActiveDashboard as string == "Customers" ? "active" : null)"
                           asp-controller="MaintenanceDashboards" asp-action="Customers">
                            <i class="fas fa-users" style="color: yellowgreen; font-size: 14px;"></i>
                            Customers
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveDashboard as string == "Bills" ? "active" : null)"
                           asp-controller="MaintenanceDashboards" asp-action="Bills">
                            <i class="fas fa-money-bill" style="color: yellowgreen; font-size: 14px;"></i>
                            Bills
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveDashboard as string == "Collections" ? "active" : null)"
                           asp-controller="MaintenanceDashboards" asp-action="Collections">
                            <i class="fas fa-hand-holding-usd" style="color: yellowgreen; font-size: 14px;"></i>
                            Collections
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewBag.ActiveDashboard as string == "Users" ? "active" : null)"
                           asp-controller="MaintenanceDashboards" asp-action="Users">
                            <i class="fas fa-user-shield" style="color: yellowgreen; font-size: 14px;"></i>
                            Users
                        </a>
                    </li>
                </ul>

                <div class="dashboard-back-link">
                    <a asp-controller="MaintenanceNew" asp-action="Index">
                        <i class="fas fa-arrow-left" style="color: yellowgreen; font-size: 14px;"></i>
                        Back to Maintenance
                    </a>
                </div>
            </div>

            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
