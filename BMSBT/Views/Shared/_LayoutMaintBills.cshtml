<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" />

    
 @*    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
   
    <title>@ViewData["Title"] - Billing System</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <style>
        .sidebar {
            position: absolute; /* Allow normal scrolling behavior */
        }

        .sidebar-home-logo {
            display: block;
            max-width: 100%;
            width: 100%;
            height: auto;
            margin: 0 auto 12px auto;
        }
a {
            text-decoration: none !important;
        }
/* Hide Quick Links block on Maintenance sidebar */
        .quick-links-block {
            display: none !important;
        }
    </style>

</head>
<body>

    @await Html.PartialAsync("_TopBars", "Maintenance")

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar">
                <img src="~/images/homelogo03.png" alt="Home Logo" class="sidebar-home-logo" />

                <ul class="nav flex-column">
                    @* <li>
                        <a asp-controller="Maintenance" asp-action="Index">
                            <i class='fas fa-users' style="color: yellowgreen; font-size: 14px;"></i>
                           Home
                        </a>
                    </li> *@

                
                    <li>
                        <a asp-controller="MaintenanceNew" asp-action="Index">
                            <i class="fas fa-chart-line" style="color: yellowgreen; font-size: 14px;"></i>
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#billPaymentsSubMenuMaint"
                           role="button"
                           aria-expanded="false"
                           aria-controls="billPaymentsSubMenuMaint">
                            <span>
                                <i class="fas fa-money-bill" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Bill Payments
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="billPaymentsSubMenuMaint">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="MaintenanceNew" asp-action="Operations">
                                        <i class="fas fa-tasks" style="color: yellowgreen; font-size: 14px;"></i>
                                        Payment Status
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="MaintenanceBill" asp-action="PaymentForm">
                                        <i class="fas fa-edit" style="color: yellowgreen; font-size: 14px;"></i>
                                        Pay Bill(s)
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a asp-controller="MaintenanceNew" asp-action="CustomersMaintenance">
                            <i class="fas fa-user-cog" style="color: yellowgreen; font-size: 14px;"></i>
                            Customers
                        </a>
                    </li>

                    <li>
                        <a asp-controller="MaintenanceNew" asp-action="SearchBill">
                            <i class="fas fa-search" style="color: yellowgreen; font-size: 14px;"></i>
                            All Bills
                        </a>
                    </li>

                    <li>
                        <a asp-controller="MaintenanceNew" asp-action="GenerateBill">
                            <i class='fas fa-users' style="color: yellowgreen; font-size: 14px;"></i>
                            Generate Bills
                        </a>
                    </li>

                    <li>
                        <a asp-controller="MaintenanceBillingReports" asp-action="Summary">
                            <i class="fas fa-chart-pie" style="color: yellowgreen; font-size: 14px;"></i>
                            Reports
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("PrintMMultiBills", "MaintenanceNew")">
                            <i class="fas fa-print" style="color: yellowgreen; font-size: 14px;"></i>
                            Print Bill
                        </a>
                    </li>

                </ul>

                <h4>Modules</h4>

                <ul class="nav flex-column">
                    <!-- Twistee with collapsible internal links (Maintenance) -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#twisteeSubMenuMaintenance"
                           role="button"
                           aria-expanded="false"
                           aria-controls="twisteeSubMenuMaintenance">
                            <span>
                                <i class='fas fa-money-bill' style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Other Links
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="twisteeSubMenuMaintenance">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="AdditionalCharges" asp-action="Index">
                                        <i class='fas fa-plus-circle' style="color: yellowgreen; font-size: 14px;"></i>
                                        Additional Charges
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="MaintenanceNew" asp-action="MaintenanceReports">
                                        <i class="fas fa-search" style="color: yellowgreen; font-size: 14px;"></i>
                                        Project Report
                                    </a>
                                </li>
                            </ul>

                        </div>
                    </li>

                    <!-- Settings (same links as former Home sidebar) -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#twisteeSubMenuSettingsMaint"
                           role="button"
                           aria-expanded="false"
                           aria-controls="twisteeSubMenuSettingsMaint">
                            <span>
                                <i class="fas fa-cog" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Settings
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="twisteeSubMenuSettingsMaint">
                            <ul class="nav flex-column ml-3">
                                <li>
                                    <a asp-controller="OperatorSetup" asp-action="Index">
                                        <i class="fas fa-id-badge" style="color: yellowgreen; font-size: 14px;"></i>
                                        Operator Setup
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="MaintenanceBill" asp-action="MaintTariff">
                                        <i class="fas fa-cog" style="color: yellowgreen; font-size: 14px;"></i>
                                        Tariff Rates
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                </ul>

                <!-- Separate Quick Links Block -->
                <div class="quick-links-block">
                    <h4>Quick Links</h4>
                    <ul class="nav flex-column">
                        <li>
                            <a asp-controller="MaintenanceBill" asp-action="MaintTariff">

                                <i class='fas fa-arrow-left' style="color: antiquewhite; font-size: 14px; font-weight: bold;"></i>
                                Rates Setup
                            </a>
                        </li>

                        <li>
                            <a asp-controller="EBillU" asp-action="Index">
                                <i class='fas fa-arrow-left' style="color: antiquewhite; font-size: 14px; font-weight: bold;"></i>
                                Electricity Bill
                            </a>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Right Content Area -->
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    @*   <!-- Footer -->
    <footer class="footer text-white text-center py-3 footerarea">
        <p>&copy; 2024 My Application. All rights reserved.</p>
    </footer> *@

   @*  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script> *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        $(document).on('show.bs.collapse', '#billPaymentsSubMenuMaint', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#billPaymentsSubMenuMaint', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });
        $(document).on('show.bs.collapse', '#twisteeSubMenuMaintenance', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#twisteeSubMenuMaintenance', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });
        $(document).on('show.bs.collapse', '#twisteeSubMenuSettingsMaint', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        });
        $(document).on('hide.bs.collapse', '#twisteeSubMenuSettingsMaint', function () {
            $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });
    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>
