@{
    ViewData["Title"] = "All Modules";
    Layout = "~/Views/Shared/_LayoutAllModules.cshtml";
}

<style>
</style>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billing Management System - All Modules</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .container {
            margin-top: 5px;
        }

        .section-card {
            border: 1px solid #dee2e6;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .section-card:hover {
                box-shadow: 0 6px 8px rgba(0, 0, 0, 0.2);
            }

        .section-title {
            color: #142141;
            font-weight: bold;
        }

        .btn-primary {
            background-color: #142141;
            border: none;
        }

            .btn-primary:hover {
                background-color: #0d1733;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row mt-5">
            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-sliders-h" style="color: #142141; font-size: 16px;"></i>
                        Adjustments
                    </h5>
                    <p>Manage billing adjustments, including charges and credits applied to customer accounts.</p>
                    <a asp-controller="Adjustments" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-gavel" style="color: #142141; font-size: 16px;"></i>
                        Fine
                    </h5>
                    <p>Create and track fines by BT number, service type, month, and year.</p>
                    <a asp-controller="Fine" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-clipboard-list" style="color: #142141; font-size: 16px;"></i>
                        Activities
                    </h5>
                    <p>View and manage system activities and related operational records.</p>
                    <a asp-controller="Activities" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-edit" style="color: #142141; font-size: 16px;"></i>
                        All Users
                    </h5>
                    <p>Create and manage user accounts, roles, and access permissions.</p>
                    <a asp-controller="UsersManagement" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-table" style="color: #142141; font-size: 16px;"></i>
                        Configurations
                    </h5>
                    <p>Manage system configuration settings used across billing modules.</p>
                    <a asp-controller="Configs" asp-action="AllConfigs" class="btn btn-success">Click to Process</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-cog" style="color: #142141; font-size: 16px;"></i>
                        Setup
                    </h5>
                    <p>Access setup options and related system configuration modules.</p>
                    <a asp-controller="Setup" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card section-card p-3">
                    <h5 class="section-title">
                        <i class="fas fa-history" style="color: #142141; font-size: 16px;"></i>
                        History/Logs
                    </h5>
                    <p>View billing history and system logs across functionalities.</p>
                    <a asp-controller="HistoryLogs" asp-action="Index" class="btn btn-success">Click to Process</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
