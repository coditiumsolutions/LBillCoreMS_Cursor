@model BMSBT.DTO.BillDTO

@{
    ViewData["Title"] = "Payment Details";
    Layout = "~/Views/Shared/_LayoutEBills.cshtml";
}

<style>
    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        color: #000;
        margin-bottom: 0.75rem;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
    }

    .details-table td {
        padding: 4px 8px;
        vertical-align: top;
        border: none;
    }

    .details-label {
        font-weight: 600;
        color: #000;
        width: 18%;
        white-space: nowrap;
    }

    .details-value {
        color: #0056b3;
        width: 32%;
        word-break: break-word;
    }
</style>

<div class="details-header">
    Payment Details
</div>

<table class="details-table">
    <tr>
        <td class="details-label">BT Number</td>
        <td class="details-value">@Model.Btno</td>
        <td class="details-label">Block</td>
        <td class="details-value">@Model.Block</td>
    </tr>
    <tr>
        <td class="details-label">Month</td>
        <td class="details-value">@Model.BillingMonth</td>
        <td class="details-label">Year</td>
        <td class="details-value">@Model.BillingYear</td>
    </tr>
    <tr>
        <td class="details-label">Payment Status</td>
        <td class="details-value">@Model.PaymentStatus</td>
        <td class="details-label">Payment Date</td>
        <td class="details-value">@Model.PaymentDate</td>
    </tr>
    <tr>
        <td class="details-label">Payment Method</td>
        <td class="details-value">@Model.PaymentMethod</td>
        <td class="details-label">Bank Detail</td>
        <td class="details-value">@Model.BankDetail</td>
    </tr>
    <tr>
        <td class="details-label">History</td>
        <td class="details-value" colspan="3" style="white-space: pre-line;">@Model.History</td>
    </tr>
</table>

<div class="mt-3">
    <a href="@Url.Action("PaidDetails", "EBillU")" class="btn btn-secondary">Back</a>
</div>
