@using BMSBT.DTO
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BillDTO>

@{
    Layout = "~/Views/Shared/_LayoutEBills.cshtml";
    var bills = Model ?? new StaticPagedList<BillDTO>(new List<BillDTO>(), 1, 50, 0);
    var selectedSearch = ViewBag.SelectedSearch as string ?? "";
    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
}

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form method="get" asp-action="PaidDetails" asp-controller="EBillU" class="mb-3">
    <div class="row g-3">
        <div class="col-md-6">
            <label for="search" class="form-label">Search <span class="text-danger">*</span></label>
            <input type="text"
                   id="search"
                   name="search"
                   value="@selectedSearch"
                   class="form-control w-100"
                   placeholder="BTNo, Name or CNIC"
                   required
                   autofocus />
        </div>
        <div class="col-md-3">
            <label for="month" class="form-label">Billing Month</label>
            <select id="month" name="month" class="form-control w-100">
                <option value="">-- All --</option>
                @foreach (var monthName in System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12))
                {
                    if (string.Equals(monthName, selectedMonth, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@monthName" selected>@monthName</option>
                    }
                    else
                    {
                        <option value="@monthName">@monthName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="year" class="form-label">Billing Year</label>
            <select id="year" name="year" class="form-control w-100">
                <option value="">-- All --</option>
                @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 10; i--)
                {
                    var y = i.ToString();
                    if (y == selectedYear)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            <div class="d-flex" style="gap: 1rem;">
                <button type="submit" class="btn btn-primary" style="min-width:140px">Search</button>
            </div>
        </div>
    </div>
</form>

@if (Model != null && Model.TotalItemCount > 0)
{
    <div class="text-muted small mb-2">
        Showing @bills.FirstItemOnPage–@bills.LastItemOnPage of @bills.TotalItemCount
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:40px">
                    <input type="checkbox" id="selectAll" title="Select all on this page" />
                </th>
                <th>BTNo</th>
                <th>Block</th>
                <th>Month</th>
                <th>Year</th>
                <th>Payment Status</th>
                <th>Payment Date</th>
                <th>Payment Method</th>
                <th>Bank Detail</th>
                <th>History</th>
            </tr>
        </thead>
        <tbody>
            @if (bills.Any())
            {
                @foreach (var bill in bills)
                {
                    <tr ondblclick="window.location.href='@Url.Action("PaidDetailsView", "EBillU", new { id = bill.Uid })'" style="cursor: pointer;">
                        <td>
                            <input type="checkbox"
                                   class="record-checkbox"
                                   value="@bill.Uid"
                                   data-btno="@bill.Btno"
                                   data-month="@bill.BillingMonth"
                                   data-year="@bill.BillingYear" />
                        </td>
                        <td>@bill.Btno</td>
                        <td>@bill.Block</td>
                        <td>@bill.BillingMonth</td>
                        <td>@bill.BillingYear</td>
                        <td>@bill.PaymentStatus</td>
                        <td>@bill.PaymentDate</td>
                        <td>@bill.PaymentMethod</td>
                        <td>@bill.BankDetail</td>
                        <td>@bill.History</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(ViewBag.ErrorMessage as string)
                            ? "Enter BTNo, Name or CNIC and click Search."
                            : "No records found.")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.TotalItemCount > 0)
{
    <div class="d-flex justify-content-end mt-3">
        @Html.PagedListPager(Model, pageNumber => Url.Action("PaidDetails", new
        {
            search = selectedSearch,
            month = selectedMonth,
            year = selectedYear,
            page = pageNumber
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination mb-0" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5
        })
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#selectAll').change(function () {
                $('.record-checkbox').prop('checked', this.checked);
            });

            $('.record-checkbox').change(function () {
                var total = $('.record-checkbox').length;
                var checked = $('.record-checkbox:checked').length;
                $('#selectAll').prop({
                    checked: total === checked && total > 0,
                    indeterminate: checked > 0 && checked < total
                });
            });
        });
    </script>
}
