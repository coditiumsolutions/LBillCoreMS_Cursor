@model BMSBT.DTO.DashboardViewModel
@{
    ViewData["Title"] = "Electricity Home";
    Layout = "~/Views/Shared/_LayoutEBills.cshtml";
    var projects = Model?.Projects ?? new List<string>();
    var years = Model?.Years ?? new List<string>();
    if (!years.Any())
    {
        years = Enumerable.Range(DateTime.Now.Year - 5, 8).Select(y => y.ToString()).Reverse().ToList();
    }

    var totalCustomers = Model?.TotalCustomers ?? 0;
    var totalBills = Model?.TotalBillsGenerated ?? 0;
    var paidBills = Model?.TotalBillsPaid ?? 0;
    var unpaidBills = Model?.UnpaidBillsCount ?? 0;
    var projectLabels = Model?.ChartProjectLabels ?? new List<string>();
    var projectCustomers = Model?.ChartProjectCustomerCounts ?? new List<int>();
    var projectBills = Model?.ChartProjectBillCounts ?? new List<int>();
}

<style>
    .eb-home {
        --eb-primary: #1e5f8a;
        --eb-border: #d7e2ea;
        --eb-text: #1a1a1a;
        --eb-muted: #5a6a75;
        padding: 1rem 1.25rem 1.5rem;
        color: var(--eb-text);
        min-height: calc(100vh - 200px);
        background-color: #f7f9fc;
        background-image:
            linear-gradient(180deg, rgba(255, 255, 255, 0.86) 0%, rgba(247, 249, 252, 0.9) 100%),
            url('@Url.Content("~/images/buildings.png")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: local;
        border-radius: 8px;
    }

    .eb-filters {
        background: #fff;
        border: 1px solid var(--eb-border);
        border-radius: 10px;
        padding: 1.15rem 1.25rem;
        margin-bottom: 1.15rem;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
    }

    .eb-filter-row {
        display: flex;
        flex-wrap: nowrap;
        align-items: flex-end;
        gap: 0.65rem;
    }

    .eb-filter-field {
        flex: 1 1 0;
        min-width: 0;
    }

    .eb-filter-field label {
        display: block;
        font-size: 0.7rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #000;
        margin-bottom: 0.25rem;
    }

    .eb-filter-field .form-control {
        width: 100%;
        height: 36px;
        border: 1px solid var(--eb-border);
        border-radius: 6px;
        font-size: 0.85rem;
        background: #fafcfd;
        padding: 0.25rem 0.5rem;
        color: #000;
    }

    .eb-filter-field .form-control option {
        color: #000;
    }

    .eb-filter-actions {
        flex: 0 0 auto;
    }

    .eb-btn-generate {
        background: var(--eb-primary);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        height: 36px;
        white-space: nowrap;
    }

    .eb-btn-generate:hover {
        background: #174d70;
        color: #fff;
    }

    .eb-stat-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.15rem;
    }

    .eb-stat-card {
        flex: 1 1 180px;
        background: #fff;
        border: 1px solid var(--eb-border);
        border-radius: 10px;
        padding: 1.1rem 1.25rem;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
    }

    .eb-stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--eb-muted);
        margin-bottom: 0.4rem;
    }

    .eb-stat-value {
        font-size: 1.6rem;
        font-weight: 500;
        color: #1565c0;
        font-variant-numeric: tabular-nums;
        margin: 0;
    }

    .eb-chart-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .eb-chart-card {
        flex: 1 1 320px;
        background: #fff;
        border: 1px solid var(--eb-border);
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .eb-chart-card.eb-chart-wide {
        flex: 1 1 100%;
    }

    .eb-chart-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--eb-border);
        font-size: 0.9rem;
        color: #334155;
        background: #f8fafc;
    }

    .eb-chart-body {
        padding: 1rem;
        height: 320px;
        position: relative;
    }

    .eb-chart-body-tall {
        height: 380px;
    }

    @@media (max-width: 768px) {
        .eb-filter-row {
            flex-wrap: wrap;
        }

        .eb-filter-field {
            flex: 1 1 calc(50% - 0.65rem);
        }

        .eb-filter-actions {
            flex: 1 1 100%;
        }

        .eb-btn-generate {
            width: 100%;
        }
    }
</style>

<div class="eb-home">
    <div class="eb-filters">
        @using (Html.BeginForm("Index", "EBillU", FormMethod.Get))
        {
            <div class="eb-filter-row">
                <div class="eb-filter-field">
                    <label for="month">Billing Month</label>
                    @Html.DropDownList(
                        "month",
                        new SelectList(
                            new[] { "January", "February", "March", "April", "May", "June",
                                    "July", "August", "September", "October", "November", "December" }
                                .Select(m => new { Value = m, Text = m }),
                            "Value", "Text", ViewBag.SelectedMonth as string),
                        "Select Month",
                        new { @class = "form-control", id = "month" })
                </div>

                <div class="eb-filter-field">
                    <label for="year">Billing Year</label>
                    @Html.DropDownList(
                        "year",
                        new SelectList(
                            years.Select(y => new { Value = y, Text = y }),
                            "Value", "Text", ViewBag.SelectedYear as string),
                        "Select Year",
                        new { @class = "form-control", id = "year" })
                </div>

                <div class="eb-filter-field">
                    <label for="project">Project</label>
                    @Html.DropDownList(
                        "project",
                        new SelectList(
                            projects.Select(p => new { Value = p, Text = p }),
                            "Value", "Text", ViewBag.SelectedProject as string),
                        "All Projects",
                        new { @class = "form-control", id = "project" })
                </div>

                <div class="eb-filter-actions">
                    <button type="submit" class="btn eb-btn-generate">Generate</button>
                </div>
            </div>
        }
    </div>

    <div class="eb-stat-row">
        <div class="eb-stat-card">
            <div class="eb-stat-label">Total Customers</div>
            <p class="eb-stat-value">@totalCustomers.ToString("N0")</p>
        </div>
        <div class="eb-stat-card">
            <div class="eb-stat-label">Total Bills Generated</div>
            <p class="eb-stat-value">@totalBills.ToString("N0")</p>
        </div>
        <div class="eb-stat-card">
            <div class="eb-stat-label">Paid Bills</div>
            <p class="eb-stat-value">@paidBills.ToString("N0")</p>
        </div>
        <div class="eb-stat-card">
            <div class="eb-stat-label">Unpaid Bills</div>
            <p class="eb-stat-value">@unpaidBills.ToString("N0")</p>
        </div>
    </div>

    <div class="eb-chart-row">
        <div class="eb-chart-card">
            <div class="eb-chart-header">Customers vs Bills Generated</div>
            <div class="eb-chart-body">
                <canvas id="overviewBarChart"></canvas>
            </div>
        </div>
        <div class="eb-chart-card">
            <div class="eb-chart-header">Payment Status</div>
            <div class="eb-chart-body">
                <canvas id="paymentStatusChart"></canvas>
            </div>
        </div>
        <div class="eb-chart-card eb-chart-wide">
            <div class="eb-chart-header">Customers &amp; Bills by Project</div>
            <div class="eb-chart-body eb-chart-body-tall">
                <canvas id="projectBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const overviewCtx = document.getElementById('overviewBarChart');
            const paymentCtx = document.getElementById('paymentStatusChart');
            const projectCtx = document.getElementById('projectBarChart');

            if (overviewCtx) {
                new Chart(overviewCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Total Customers', 'Bills Generated'],
                        datasets: [{
                            label: 'Count',
                            data: [@totalCustomers, @totalBills],
                            backgroundColor: ['#1e5f8a', '#2a9d8f'],
                            borderRadius: 6,
                            maxBarThickness: 64
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            if (paymentCtx) {
                new Chart(paymentCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Paid', 'Unpaid'],
                        datasets: [{
                            data: [@paidBills, @unpaidBills],
                            backgroundColor: ['#2a9d8f', '#e76f51'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }

            if (projectCtx) {
                new Chart(projectCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(projectLabels)),
                        datasets: [
                            {
                                label: 'Customers',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(projectCustomers)),
                                backgroundColor: '#1e5f8a',
                                borderRadius: 4,
                                maxBarThickness: 40
                            },
                            {
                                label: 'Bills Generated',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(projectBills)),
                                backgroundColor: '#2a9d8f',
                                borderRadius: 4,
                                maxBarThickness: 40
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
