@using BMSBT.DTO
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BillDTO>

@{
    ViewData["Title"] = "Print Bill";
    Layout = "~/Views/Shared/_LayoutEBills.cshtml";
    var bills = Model ?? new StaticPagedList<BillDTO>(new List<BillDTO>(), 1, 50, 0);
    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
    var selectedBtNo = ViewBag.SelectedBtNo as string ?? "";
    var selectedBlock = ViewBag.SelectedBlock as string ?? "";
    var blocks = ViewBag.Blocks as List<string> ?? new List<string>();
}

<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-spinner"></div>
    <div class="loading-text">Printing Bills...</div>
</div>

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 5px solid #f3f3f3;
        border-radius: 50%;
        border-top: 5px solid #3498db;
        animation: spin 1s linear infinite;
    }

    .loading-text {
        color: white;
        margin-top: 20px;
        font-size: 18px;
        font-weight: bold;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form method="get" asp-action="PrintBill" asp-controller="EBillU" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <label for="month" class="form-label">Month</label>
            <select id="month" name="month" class="form-control w-100">
                <option value="">-- Month --</option>
                @foreach (var monthName in System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12))
                {
                    if (string.Equals(monthName, selectedMonth, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@monthName" selected>@monthName</option>
                    }
                    else
                    {
                        <option value="@monthName">@monthName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="year" class="form-label">Year</label>
            <select id="year" name="year" class="form-control w-100">
                <option value="">-- Year --</option>
                @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 10; i--)
                {
                    var y = i.ToString();
                    if (y == selectedYear)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="block" class="form-label">Block</label>
            <select id="block" name="block" class="form-control w-100">
                <option value="">-- All Blocks --</option>
                @foreach (var blk in blocks)
                {
                    if (string.Equals(blk, selectedBlock, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@blk" selected>@blk</option>
                    }
                    else
                    {
                        <option value="@blk">@blk</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="BtNo" class="form-label">BTNo</label>
            <input type="text" id="BtNo" name="BtNo" value="@selectedBtNo" class="form-control w-100" placeholder="Enter BTNo" />
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" style="min-width:140px">Search</button>
                <button id="PrintRecordsButton" type="button" class="btn btn-secondary" style="min-width:140px">Print Bill</button>
            </div>
        </div>
    </div>
</form>

@if (Model != null && Model.TotalItemCount > 0)
{
    <div class="text-muted small mb-2">
        Showing @bills.FirstItemOnPage–@bills.LastItemOnPage of @bills.TotalItemCount
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:40px">
                    <input type="checkbox" id="selectAll" title="Select all on this page" />
                </th>
                <th>BTNo</th>
                <th>Block</th>
                <th>Plot No</th>
                <th>Category</th>
                <th>Month</th>
                <th>Year</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @if (bills.Any())
            {
                @foreach (var bill in bills)
                {
                    <tr>
                        <td>
                            <input type="checkbox"
                                   class="record-checkbox"
                                   value="@bill.Uid"
                                   data-btno="@bill.Btno"
                                   data-month="@bill.BillingMonth"
                                   data-year="@bill.BillingYear" />
                        </td>
                        <td>@bill.Btno</td>
                        <td>@bill.Block</td>
                        <td>@bill.PloNo</td>
                        <td>@bill.Category</td>
                        <td>@bill.BillingMonth</td>
                        <td>@bill.BillingYear</td>
                        <td>@bill.PaymentStatus</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(ViewBag.ErrorMessage as string)
                            ? "Select filters and click Search to load bills."
                            : "No records found.")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.TotalItemCount > 0)
{
    <div class="d-flex justify-content-end mt-3">
        @Html.PagedListPager(Model, pageNumber => Url.Action("PrintBill", new
        {
            month = selectedMonth,
            year = selectedYear,
            BtNo = selectedBtNo,
            block = selectedBlock,
            page = pageNumber
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination mb-0" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5
        })
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#selectAll').change(function () {
                $('.record-checkbox').prop('checked', this.checked);
            });

            $('.record-checkbox').change(function () {
                var total = $('.record-checkbox').length;
                var checked = $('.record-checkbox:checked').length;
                $('#selectAll').prop({
                    checked: total === checked && total > 0,
                    indeterminate: checked > 0 && checked < total
                });
            });

            $("#PrintRecordsButton").on("click", function () {
                // Build parallel BTNo / Month / Year arrays from checked rows
                var items = [];
                $('.record-checkbox:checked').each(function () {
                    var btNo = String($(this).data('btno') || '').trim();
                    var month = String($(this).data('month') || '').trim();
                    var year = String($(this).data('year') || '').trim();
                    if (btNo && month && year) {
                        items.push({ btNo: btNo, month: month, year: year });
                    }
                });

                if (items.length === 0) {
                    alert("Please select at least one bill to print.");
                    return;
                }

                $("#loadingOverlay").show();

                $.ajax({
                    url: '/PrintElectricitySingleBills',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ items: items }),
                    xhrFields: { responseType: 'blob' }
                }).done(function (blobData, status, xhr) {
                    var contentType = xhr.getResponseHeader("content-type") || '';
                    if (contentType.indexOf("application/pdf") !== -1) {
                        var blob = new Blob([blobData], { type: 'application/pdf' });
                        window.open(URL.createObjectURL(blob), '_blank');
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function () {
                        alert('Print failed: ' + (reader.result || 'Unknown error'));
                    };
                    reader.readAsText(blobData);
                }).fail(function (xhr) {
                    var blob = xhr.response || xhr.responseBlob;
                    if (blob && typeof Blob !== 'undefined' && blob instanceof Blob) {
                        var reader = new FileReader();
                        reader.onload = function () {
                            alert('Print failed: ' + (reader.result || xhr.statusText || 'Server error'));
                        };
                        reader.readAsText(blob);
                    } else if (xhr.responseText) {
                        alert('Print failed: ' + xhr.responseText);
                    } else {
                        alert('Print failed: ' + (xhr.statusText || 'Server error'));
                    }
                }).always(function () {
                    $("#loadingOverlay").hide();
                });
            });
        });
    </script>
}
