@model BMSBT.ViewModels.MaintenanceBillingReportViewModel
@{
    ViewData["Title"] = "Customers Report";
    Layout = "~/Views/Shared/_LayoutMaintenanceBillingReports.cshtml";
    ViewBag.ReportAction = "Customers";
    if (Model.HasResults)
    {
        ViewBag.Chart1Title = "Customers by project (top 12)";
        ViewBag.Chart2Title = "Customers by block (top 12)";
    }
}

<h4 class="mb-3 text-secondary">Customers report</h4>
@await Html.PartialAsync("_MaintenanceBillingReportFilters", Model)

@if (Model.HasResults)
{
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card report-kpi-card shadow-sm">
                <div class="card-body">
                    <div class="small text-muted">Total maintenance customers</div>
                    <div class="kpi-value">@Model.TotalCustomers.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_ReportCharts")
}
else
{
    @await Html.PartialAsync("_MaintenanceBillingReportPrompt")
}

@section Scripts {
    @if (Model.HasResults)
    {
        @await Html.PartialAsync("_MaintenanceDashboardBarChartsScript")
    }
}
