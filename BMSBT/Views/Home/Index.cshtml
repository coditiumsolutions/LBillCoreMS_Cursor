@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .home-modules {
        margin-top: 1rem;
    }

    .module-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #d9e0ea;
        border-radius: 12px;
        background-color: #f7f9fc;
        background-image:
            linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(247, 249, 252, 0.9) 100%),
            url('@Url.Content("~/images/buildings.png")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow: 0 4px 14px rgba(20, 33, 65, 0.08);
        padding: 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
        overflow: hidden;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(20, 33, 65, 0.14);
        border-color: #b8c6db;
    }

    .module-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #fff;
        font-size: 1.35rem;
    }

    .module-icon.customers { background: linear-gradient(135deg, #1f6feb, #0d47a1); }
    .module-icon.ebilling { background: linear-gradient(135deg, #f0ad4e, #d48806); }
    .module-icon.mbilling { background: linear-gradient(135deg, #28a745, #1e7e34); }
    .module-icon.reports { background: linear-gradient(135deg, #3d5a80, #1b3a57); }
    .module-icon.reading { background: linear-gradient(135deg, #17a2b8, #117a8b); }
    .module-icon.audit { background: linear-gradient(135deg, #dc3545, #a71d2a); }
    .module-icon.allmodules { background: linear-gradient(135deg, #142141, #0d1733); }

    .module-title {
        color: #142141;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .module-desc {
        color: #5b6777;
        font-size: 0.92rem;
        line-height: 1.45;
        flex-grow: 1;
        margin-bottom: 1rem;
    }

    .module-btn {
        background-color: #142141;
        border: none;
        color: #fff;
        border-radius: 8px;
        padding: 0.55rem 0.9rem;
        font-weight: 600;
        text-align: center;
        transition: background-color 0.2s ease;
    }

    .module-btn:hover {
        background-color: #0d1733;
        color: #fff;
        text-decoration: none;
    }

    .module-btn i {
        margin-left: 6px;
        font-size: 0.85rem;
    }
</style>

<div class="home-modules">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon customers">
                    <i class="fas fa-users"></i>
                </div>
                <h5 class="module-title">Customer's Detail</h5>
                <p class="module-desc">Manage customer information, including personal details, contact information, and account status.</p>
                <a asp-controller="SSQCustomers" asp-action="Index" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon ebilling">
                    <i class="fas fa-bolt"></i>
                </div>
                <h5 class="module-title">E-Billing</h5>
                <p class="module-desc">Generate and manage electricity bills based on consumption, tariff rates, and payment history.</p>
                <a href="EBillU" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon mbilling">
                    <i class="fas fa-money-bill"></i>
                </div>
                <h5 class="module-title">M-Billing</h5>
                <p class="module-desc">Handle maintenance charges, service fees, and related billing transactions.</p>
                <a href="MaintenanceNew" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon reports">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <h5 class="module-title">Reports</h5>
                <p class="module-desc">Generate detailed reports on billing, payments, outstanding dues, and overall system performance.</p>
                <a href="Reports" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon reading">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <h5 class="module-title">Reading Details</h5>
                <p class="module-desc">Record and track electricity consumption through periodic meter readings to ensure accurate billing.</p>
                <a href="ReadingSheet/ReadingDetails" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon audit">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h5 class="module-title">Audit</h5>
                <p class="module-desc">Review system audit logs, tariff and tax changes, billing summaries, and related compliance activity.</p>
                <a asp-controller="Audit" asp-action="Index" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="module-card">
                <div class="module-icon allmodules">
                    <i class="fas fa-th"></i>
                </div>
                <h5 class="module-title">All Modules</h5>
                <p class="module-desc">Access additional system modules and extra links from a single hub.</p>
                <a asp-controller="AllModules" asp-action="Index" class="module-btn">
                    Open Module <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
